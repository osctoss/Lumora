# ─── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://intellisave:intellisave@localhost:5432/intellisave?schema=public"

# ─── API Server ────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# ─── Frontend ──────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001

# ─── Simulation Defaults ──────────────────────────────────
DEFAULT_SIMULATION_SPEED=1
DEFAULT_TARIFF_INR_PER_KWH=8
DEFAULT_CO2_FACTOR_KG_PER_KWH=0.82

# ─── AI / LLM (optional — system works without these) ─────
# OPENAI_API_KEY=sk-...
# GOOGLE_AI_KEY=...
# AI_PROVIDER=none
